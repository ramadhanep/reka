# REKA Autonomous Engineering configuration.
#
# Sourced by agent-reka-runner.sh. Environment variables already present when
# the runner starts take precedence over the defaults below.

# --- Model per phase (provider/model). Empty = opencode default. ---
REKA_MODEL_PLANNER="${REKA_MODEL_PLANNER:-}"
REKA_MODEL_EXECUTOR="${REKA_MODEL_EXECUTOR:-}"
REKA_MODEL_REVIEWER="${REKA_MODEL_REVIEWER:-}"
REKA_MODEL_FIXER="${REKA_MODEL_FIXER:-}"

# --- Budget: available model usage is a finite daily engineering budget. ---
# Maximum OpenCode sessions started per day (all phases).
REKA_DAILY_BUDGET_SESSIONS="${REKA_DAILY_BUDGET_SESSIONS:-6}"
# Enforce a token ceiling only when the value is greater than 0.
REKA_DAILY_BUDGET_TOKENS="${REKA_DAILY_BUDGET_TOKENS:-0}"
# Wall-clock limit for a single run, in seconds.
REKA_MAX_RUN_TIME="${REKA_MAX_RUN_TIME:-1800}"
# Execution/fix sessions per run before the run stops and saves progress.
REKA_MAX_EXECUTION_SESSIONS="${REKA_MAX_EXECUTION_SESSIONS:-2}"
# Review/fix loops before the run becomes BLOCKED and records debt.
REKA_MAX_REVIEW_LOOPS="${REKA_MAX_REVIEW_LOOPS:-2}"
# Completed plans per run. Keep at 1 so planning is only done when needed.
REKA_MAX_TASKS_PER_RUN="${REKA_MAX_TASKS_PER_RUN:-1}"

# --- Git policy ---
# Expected branch. The runner refuses to run on any other branch.
REKA_BRANCH="${REKA_BRANCH:-main}"
# Push reviewed commits. Set to 0 to commit locally only.
REKA_PUSH="${REKA_PUSH:-1}"
# Optional command run after review PASS and before commit. Empty = skip.
REKA_PRECOMMIT_VERIFY="${REKA_PRECOMMIT_VERIFY:-}"

# --- Runtime ---
REKA_OPENCODE_BIN="${REKA_OPENCODE_BIN:-opencode}"
REKA_OPENCODE_EXTRA_ARGS="${REKA_OPENCODE_EXTRA_ARGS:-}"
REKA_PLAN_TIMEOUT="${REKA_PLAN_TIMEOUT:-600}"
REKA_EXECUTE_TIMEOUT="${REKA_EXECUTE_TIMEOUT:-900}"
REKA_REVIEW_TIMEOUT="${REKA_REVIEW_TIMEOUT:-600}"
REKA_FIX_TIMEOUT="${REKA_FIX_TIMEOUT:-600}"
# Number of days a run record is kept before pruning.
REKA_PRUNE_DAYS="${REKA_PRUNE_DAYS:-30}"
# Always keep at least this many most recent run records.
REKA_KEEP_RUNS="${REKA_KEEP_RUNS:-50}"
